# Copie para .env e preencha a chave do provider escolhido.
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash

# Teto de chamadas ao LLM por minuto (free tier do Gemini é apertado).
# 0 = sem limite (conta paga). Ver mini_banco/limitador.py.
LLM_MAX_RPM=12

GOOGLE_API_KEY=cole-sua-chave-do-aistudio-aqui
GOOGLE_GENAI_USE_VERTEXAI=FALSE

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
